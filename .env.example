# DevFlow AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME=DevFlow AI
APP_VERSION=1.0.0
DEBUG=true
API_V1_STR=/api/v1

# ============================================
# Security (CHANGE IN PRODUCTION!)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ============================================
# Database
# ============================================
# For Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/devflow
# For local: postgresql+asyncpg://postgres:postgres@localhost:5432/devflow
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devflow

# ============================================
# Redis
# ============================================
# For Docker: redis://redis:6379/0
# For local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# GitHub OAuth
# ============================================
# Get from: https://github.com/settings/developers
# Callback URL: http://localhost:5173/auth/github/callback (or your domain)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# ============================================
# AI Provider (OpenAI or Anthropic)
# ============================================
# Choose: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Frontend URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Email (Optional - for notifications)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=DevFlow AI <noreply@devflow.ai>

# ============================================
# Sentry (Optional - for error tracking)
# ============================================
# SENTRY_DSN=your-sentry-dsn

# ============================================
# Rate Limiting (Optional)
# ============================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60